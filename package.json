{
  "name": "e-gudang-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run db:generate && next typegen && tsc --noEmit",
    "test": "node --test",
    "check": "npm run db:validate && npm run typecheck && npm run lint && npm test && npm run build",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:smoke": "node prisma/smoke.mjs",
    "auth:create-user": "node scripts/create-user.mjs",
    "auth:smoke": "node prisma/auth-smoke.mjs",
    "master:smoke": "node prisma/master-smoke.mjs",
    "import:smoke": "node prisma/import-smoke.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "exceljs": "4.4.0",
    "jsbarcode": "3.12.3",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    },
